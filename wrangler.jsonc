{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guessthegame",
  "main": ".open-next/worker.js",
  // Set this to today's date; nodejs_compat requires >= 2024-09-23.
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    // Enable Node.js APIs used by Next.js on Workers.
    "nodejs_compat",
    // Allow the Worker to fetch public URLs.
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "guessthegame",
    },
  ],
}
