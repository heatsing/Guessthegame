# Public site origin used for canonical URLs and Open Graph.
# No secrets belong in this file.
NEXT_PUBLIC_SITE_URL=https://guessthegame.net

# Public legal/contact inbox shown on Privacy, Terms, DMCA, and Copyright.
# Default in code is legal@guessthegame.net if this is unset.
NEXT_PUBLIC_CONTACT_EMAIL=legal@guessthegame.net

# Optional demo/test override for the daily puzzle UTC date (YYYY-MM-DD).
# Leave unset in production so `/`, `/archive`, and `/puzzle/[date]` use the
# real UTC calendar day. Example: DAILY_PUZZLE_DATE=2026-01-15
# DAILY_PUZZLE_DATE=
